@import "tailwindcss";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-dm-sans);
  --font-mono: var(--font-jetbrains-mono);
  /* --font-display: var(--font-syne); -- moved out to avoid Tailwind v4 --text-* auto-discovery conflict */
  --color-sidebar-ring: var(--sidebar-ring);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar: var(--sidebar);
  --color-chart-5: var(--chart-5);
  --color-chart-4: var(--chart-4);
  --color-chart-3: var(--chart-3);
  --color-chart-2: var(--chart-2);
  --color-chart-1: var(--chart-1);
  --color-ring: var(--ring);
  --color-input: var(--input);
  --color-border: var(--border);
  --color-destructive: var(--destructive);
  --color-accent-foreground: var(--accent-foreground);
  --color-accent: var(--accent);
  --color-muted-foreground: var(--muted-foreground);
  --color-muted: var(--muted);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-secondary: var(--secondary);
  --color-primary-foreground: var(--primary-foreground);
  --color-primary: var(--primary);
  --color-popover-foreground: var(--popover-foreground);
  --color-popover: var(--popover);
  --color-card-foreground: var(--card-foreground);
  --color-card: var(--card);
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);

  /* Albos Brand Colors */
  --color-albos-accent: #FF5C00;
  --color-albos-accent-hover: #E54E00;
  --color-albos-dark: #0A0A0A;
  --color-albos-mid: #141414;
  --color-albos-light: #F5F4F0;
  --color-albos-muted: #6B6B6B;
  --color-albos-border-dark: rgba(255,255,255,0.08);
  --color-albos-border-light: rgba(0,0,0,0.08);
}

:root {
  --radius: 0.625rem;
  --background: #0A0A0A;
  --foreground: #F5F4F0;
  --card: #141414;
  --card-foreground: #F5F4F0;
  --popover: #141414;
  --popover-foreground: #F5F4F0;
  --primary: #FF5C00;
  --primary-foreground: #0A0A0A;
  --secondary: #1A1A1A;
  --secondary-foreground: #F5F4F0;
  --muted: #1A1A1A;
  --muted-foreground: #6B6B6B;
  --accent: #FF5C00;
  --accent-foreground: #0A0A0A;
  --destructive: #EF4444;
  --border: rgba(255,255,255,0.08);
  --input: rgba(255,255,255,0.08);
  --ring: #FF5C00;
  --chart-1: #FF5C00;
  --chart-2: #22C55E;
  --chart-3: #3B82F6;
  --chart-4: #A855F7;
  --chart-5: #EAB308;
  --sidebar: #0A0A0A;
  --sidebar-foreground: #F5F4F0;
  --sidebar-primary: #FF5C00;
  --sidebar-primary-foreground: #0A0A0A;
  --sidebar-accent: #1A1A1A;
  --sidebar-accent-foreground: #F5F4F0;
  --sidebar-border: rgba(255,255,255,0.08);
  --sidebar-ring: #FF5C00;

  /* Albos Design Tokens */
  --albos-accent: #FF5C00;
  --albos-accent-hover: #E54E00;
  --albos-dark: #0A0A0A;
  --albos-mid: #141414;
  --albos-light: #F5F4F0;
  --albos-muted: #6B6B6B;
  --albos-border-dark: rgba(255,255,255,0.08);
  --albos-border-light: rgba(0,0,0,0.08);

  /* Typography scale */
  --fs-display: clamp(3.5rem, 9vw, 10rem);
  --fs-h1: clamp(2.5rem, 5vw, 5rem);
  --fs-h2: clamp(1.75rem, 3vw, 3rem);
  --fs-h3: clamp(1.25rem, 2vw, 1.75rem);
  --fs-body: clamp(1rem, 1.2vw, 1.125rem);
  --fs-caption: clamp(0.75rem, 1vw, 0.875rem);

  /* Spacing */
  --section-padding: clamp(5rem, 10vw, 10rem);
  --container-max: 1400px;
  --gutter: clamp(1.5rem, 4vw, 4rem);

  /* Motion */
  --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out-quart: cubic-bezier(0.76, 0, 0.24, 1);
  --duration-fast: 0.3s;
  --duration-med: 0.6s;
  --duration-slow: 1.2s;
}

/* ============================================================
   LIGHT MODE
   ============================================================ */

:root.light {
  --radius: 0.625rem;
  --background: #F5F4F0;
  --foreground: #0A0A0A;
  --card: #FFFFFF;
  --card-foreground: #0A0A0A;
  --popover: #FFFFFF;
  --popover-foreground: #0A0A0A;
  --primary: #FF5C00;
  --primary-foreground: #0A0A0A;
  --secondary: #EBE9E4;
  --secondary-foreground: #0A0A0A;
  --muted: #F0EFE9;
  --muted-foreground: #6B6B6B;
  --accent: #FF5C00;
  --accent-foreground: #0A0A0A;
  --destructive: #EF4444;
  --border: rgba(0,0,0,0.08);
  --input: rgba(0,0,0,0.08);
  --ring: #FF5C00;
  --chart-1: #FF5C00;
  --chart-2: #22C55E;
  --chart-3: #3B82F6;
  --chart-4: #A855F7;
  --chart-5: #EAB308;
  --sidebar: #F5F4F0;
  --sidebar-foreground: #0A0A0A;
  --sidebar-primary: #FF5C00;
  --sidebar-primary-foreground: #0A0A0A;
  --sidebar-accent: #EBE9E4;
  --sidebar-accent-foreground: #0A0A0A;
  --sidebar-border: rgba(0,0,0,0.08);
  --sidebar-ring: #FF5C00;

  /* Albos Design Tokens — swapped for light mode */
  --albos-accent: #FF5C00;
  --albos-accent-hover: #E54E00;
  --albos-dark: #F5F4F0;
  --albos-mid: #EBE9E4;
  --albos-light: #0A0A0A;
  --albos-muted: #6B6B6B;
  --albos-border-dark: rgba(0,0,0,0.08);
  --albos-border-light: rgba(255,255,255,0.08);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
    font-family: var(--font-dm-sans), system-ui, sans-serif;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-syne), var(--font-dm-sans), system-ui, sans-serif;
  }
}

/* Hero display heading — responsive font size using CSS custom property */
.hero-display-heading {
  font-size: 1.875rem;
}
@media (min-width: 640px) {
  .hero-display-heading { font-size: 3rem; }
}
@media (min-width: 768px) {
  .hero-display-heading { font-size: 4.5rem; }
}
@media (min-width: 1024px) {
  .hero-display-heading { font-size: var(--fs-display); }
}

/* Light mode body override */
:root.light body {
  background: var(--background);
  color: var(--foreground);
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-track {
  background: #0A0A0A;
}
::-webkit-scrollbar-thumb {
  background: #333;
  border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
  background: #555;
}

:root.light ::-webkit-scrollbar-track {
  background: #F5F4F0;
}
:root.light ::-webkit-scrollbar-thumb {
  background: #ccc;
}
:root.light ::-webkit-scrollbar-thumb:hover {
  background: #aaa;
}

/* Selection */
::selection {
  background: rgba(255, 92, 0, 0.3);
  color: #F5F4F0;
}
:root.light ::selection {
  background: rgba(255, 92, 0, 0.25);
  color: #0A0A0A;
}

/* Smooth scroll with padding for fixed navbar */
html {
  scroll-behavior: smooth;
  scroll-padding-top: 80px;
}

/* Custom cursor hide on touch devices */
@media (pointer: coarse) {
  .custom-cursor {
    display: none !important;
  }
}

/* Text balance for headings */
h1, h2, h3 {
  text-wrap: balance;
}

/* Marquee animation */
@keyframes marquee-left {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
@keyframes marquee-right {
  0% { transform: translateX(-50%); }
  100% { transform: translateX(0); }
}

.animate-marquee-left {
  animation: marquee-left 40s linear infinite;
}
.animate-marquee-right {
  animation: marquee-right 40s linear infinite;
}

/* Pulse ring animation */
@keyframes pulse-ring {
  0% { transform: scale(1); opacity: 0.5; }
  100% { transform: scale(1.5); opacity: 0; }
}
.animate-pulse-ring {
  animation: pulse-ring 2s ease-out infinite;
}

/* Scroll indicator */
@keyframes scroll-bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(8px); }
}
.animate-scroll-bounce {
  animation: scroll-bounce 2s ease-in-out infinite;
}

/* Noise texture overlay */
.noise-overlay::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 1;
}

/* Accent gradient line */
.accent-gradient-line {
  background: linear-gradient(90deg, transparent, #FF5C00, transparent);
  height: 1px;
}

/* Glass effect */
.glass {
  background: rgba(10, 10, 10, 0.8);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}
:root.light .glass {
  background: rgba(245, 244, 240, 0.85);
}

/* Light section variant */
.section-light {
  background: #F5F4F0;
  color: #0A0A0A;
}
.section-light h1, .section-light h2, .section-light h3 {
  color: #0A0A0A;
}
.section-light p {
  color: #4A4A4A;
}

/* Section dark */
.section-dark {
  background: #0A0A0A;
  color: #F5F4F0;
}

/* Light mode: swap section-dark and section-light colors */
:root.light .section-light {
  background: #0A0A0A;
  color: #F5F4F0;
}
:root.light .section-light h1,
:root.light .section-light h2,
:root.light .section-light h3 {
  color: #F5F4F0;
}
:root.light .section-light p {
  color: #9A9A9A;
}
:root.light .section-dark {
  background: #F5F4F0;
  color: #0A0A0A;
}
:root.light .section-dark h1,
:root.light .section-dark h2,
:root.light .section-dark h3 {
  color: #0A0A0A;
}
:root.light .section-dark p {
  color: #4A4A4A;
}

/* Light mode: mid section */
:root.light .section-mid {
  background: #EBE9E4;
  color: #0A0A0A;
}

/* Section mid dark */
.section-mid {
  background: #141414;
  color: #F5F4F0;
}

/* Hide scrollbar utility */
.scrollbar-hide {
  -ms-overflow-style: none;
  scrollbar-width: none;
}
.scrollbar-hide::-webkit-scrollbar {
  display: none;
}

/* ============================================================
   UTILITY CLASSES & ANIMATIONS
   ============================================================ */

/* Shimmer animation with pseudo-element overlay */
@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.shimmer {
  position: relative;
  overflow: hidden;
}

.shimmer::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.05), transparent);
  animation: shimmer 2s ease-in-out infinite;
}

/* Dot grid pattern */
.dot-grid {
  background-image: radial-gradient(circle, rgba(255, 255, 255, 0.15) 1px, transparent 1px);
  background-size: 24px 24px;
}
:root.light .dot-grid {
  background-image: radial-gradient(circle, rgba(0, 0, 0, 0.1) 1px, transparent 1px);
}

/* Mesh gradient backgrounds */
.mesh-gradient-1 {
  background:
    radial-gradient(ellipse 80% 50% at 20% 40%, rgba(255, 92, 0, 0.08), transparent),
    radial-gradient(ellipse 60% 40% at 80% 60%, rgba(255, 92, 0, 0.05), transparent),
    #0A0A0A;
}

.mesh-gradient-2 {
  background:
    radial-gradient(ellipse 60% 50% at 70% 30%, rgba(255, 92, 0, 0.06), transparent),
    radial-gradient(ellipse 80% 40% at 30% 70%, rgba(255, 92, 0, 0.04), transparent),
    #141414;
}

.mesh-gradient-3 {
  background:
    radial-gradient(ellipse 70% 60% at 50% 50%, rgba(255, 92, 0, 0.1), transparent),
    radial-gradient(ellipse 50% 40% at 10% 80%, rgba(180, 60, 0, 0.06), transparent),
    radial-gradient(ellipse 40% 30% at 90% 20%, rgba(255, 140, 50, 0.04), transparent),
    #080808;
}

/* Light mode: lighter mesh gradient variants */
:root.light .mesh-gradient-1 {
  background:
    radial-gradient(ellipse 80% 50% at 20% 40%, rgba(255, 92, 0, 0.06), transparent),
    radial-gradient(ellipse 60% 40% at 80% 60%, rgba(255, 92, 0, 0.03), transparent),
    #F5F4F0;
}
:root.light .mesh-gradient-2 {
  background:
    radial-gradient(ellipse 60% 50% at 70% 30%, rgba(255, 92, 0, 0.05), transparent),
    radial-gradient(ellipse 80% 40% at 30% 70%, rgba(255, 92, 0, 0.03), transparent),
    #EBE9E4;
}
:root.light .mesh-gradient-3 {
  background:
    radial-gradient(ellipse 70% 60% at 50% 50%, rgba(255, 92, 0, 0.06), transparent),
    radial-gradient(ellipse 50% 40% at 10% 80%, rgba(180, 60, 0, 0.04), transparent),
    radial-gradient(ellipse 40% 30% at 90% 20%, rgba(255, 140, 50, 0.02), transparent),
    #F0EFE9;
}

/* Float animation */
@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-20px); }
}

.animate-float {
  animation: float 6s ease-in-out infinite;
}

/* Text gradient */
.text-gradient {
  background: linear-gradient(135deg, #FF5C00 0%, #FF7A2E 50%, #FF5C00 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Gradient text on hover */
.gradient-text-hover {
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.gradient-text-hover:hover {
  background: linear-gradient(135deg, #FF5C00 0%, #FF8A3D 50%, #FF5C00 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Glow effect for buttons and cards */
.glow-accent {
  box-shadow: 0 0 20px rgba(255, 92, 0, 0.15), 0 0 60px rgba(255, 92, 0, 0.05);
}

.glow-accent-strong {
  box-shadow: 0 0 30px rgba(255, 92, 0, 0.25), 0 0 80px rgba(255, 92, 0, 0.1);
}

/* Pulsing glow animation (orange) */
@keyframes glow-pulse {
  0%, 100% {
    box-shadow: 0 0 15px rgba(255, 92, 0, 0.2), 0 0 40px rgba(255, 92, 0, 0.05);
  }
  50% {
    box-shadow: 0 0 25px rgba(255, 92, 0, 0.4), 0 0 60px rgba(255, 92, 0, 0.15);
  }
}

.glow-pulse {
  animation: glow-pulse 3s ease-in-out infinite;
}

/* Animated gradient border */
@keyframes gradient-rotate {
  0% { --gradient-angle: 0deg; }
  100% { --gradient-angle: 360deg; }
}

.gradient-border {
  position: relative;
  border-radius: 1rem;
  overflow: hidden;
}

.gradient-border::before {
  content: '';
  position: absolute;
  inset: 0;
  padding: 1px;
  border-radius: inherit;
  background: linear-gradient(var(--gradient-angle, 0deg), #FF5C00, transparent 40%, transparent 60%, #FF5C00);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  animation: gradient-rotate 4s linear infinite;
}

/* Animated border that moves around the element */
@keyframes border-dance {
  0% {
    background-position: 0% 0%;
  }
  25% {
    background-position: 100% 0%;
  }
  50% {
    background-position: 100% 100%;
  }
  75% {
    background-position: 0% 100%;
  }
  100% {
    background-position: 0% 0%;
  }
}

/* Clip-path reveal animation from center outward */
.reveal-mask {
  clip-path: inset(50% 50% 50% 50%);
  animation: reveal-center 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes reveal-center {
  to {
    clip-path: inset(0% 0% 0% 0%);
  }
}

/* Parallax helper classes */
.parallax-slow {
  will-change: transform;
  transition: transform 0.1s linear;
}

.parallax-fast {
  will-change: transform;
  transition: transform 0.05s linear;
}

/* 3D perspective transform for cards on hover */
.card-3d {
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  transform-style: preserve-3d;
}

.card-3d:hover {
  transform: perspective(800px) rotateY(-5deg) rotateX(5deg) scale(1.02);
}

/* SVG line drawing animation */
.line-draw {
  stroke-dasharray: 1000;
  stroke-dashoffset: 1000;
  animation: line-draw 2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes line-draw {
  to {
    stroke-dashoffset: 0;
  }
}

/* Blinking typing cursor */
@keyframes typing-cursor {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.typing-cursor::after {
  content: '█';
  animation: typing-cursor 1s step-end infinite;
  color: #FF5C00;
}

/* Staggered fadeUp for child elements */
.stagger-fade-up > * {
  opacity: 0;
  animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.stagger-fade-up > *:nth-child(1) { animation-delay: 0ms; }
.stagger-fade-up > *:nth-child(2) { animation-delay: 80ms; }
.stagger-fade-up > *:nth-child(3) { animation-delay: 160ms; }
.stagger-fade-up > *:nth-child(4) { animation-delay: 240ms; }
.stagger-fade-up > *:nth-child(5) { animation-delay: 320ms; }
.stagger-fade-up > *:nth-child(6) { animation-delay: 400ms; }
.stagger-fade-up > *:nth-child(7) { animation-delay: 480ms; }
.stagger-fade-up > *:nth-child(8) { animation-delay: 560ms; }

/* Enhanced glass morphism with border and blur */
.glass-card {
  background: rgba(10, 10, 10, 0.6);
  backdrop-filter: blur(24px) saturate(1.2);
  -webkit-backdrop-filter: blur(24px) saturate(1.2);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 1rem;
}
:root.light .glass-card {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(0, 0, 0, 0.08);
}

/* Noise texture overlay (different from noise-overlay) */
.noise-texture::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 1;
  border-radius: inherit;
  mix-blend-mode: overlay;
}

/* Reveal from bottom with clip-path */
@keyframes reveal-up {
  0% {
    clip-path: inset(100% 0 0 0);
    opacity: 0;
  }
  100% {
    clip-path: inset(0 0 0 0);
    opacity: 1;
  }
}

/* Scale from 0.8 to 1 with opacity */
@keyframes scale-reveal {
  0% {
    transform: scale(0.8);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* Directional slide reveals */
@keyframes slide-reveal-left {
  0% {
    clip-path: inset(0 100% 0 0);
    opacity: 0;
  }
  100% {
    clip-path: inset(0 0 0 0);
    opacity: 1;
  }
}

@keyframes slide-reveal-right {
  0% {
    clip-path: inset(0 0 0 100%);
    opacity: 0;
  }
  100% {
    clip-path: inset(0 0 0 0);
    opacity: 1;
  }
}

/* Custom thin scrollbar for light backgrounds */
.scrollbar-thin::-webkit-scrollbar {
  width: 4px;
}

.scrollbar-thin::-webkit-scrollbar-track {
  background: transparent;
}

.scrollbar-thin::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, 0.15);
  border-radius: 2px;
}

.scrollbar-thin::-webkit-scrollbar-thumb:hover {
  background: rgba(0, 0, 0, 0.25);
}

.scrollbar-thin {
  scrollbar-width: thin;
  scrollbar-color: rgba(0, 0, 0, 0.15) transparent;
}

/* ============================================================
   ENTRANCE & INTERACTION ANIMATIONS
   ============================================================ */

/* Slide in from left */
@keyframes slide-in-left {
  0% { transform: translateX(-20px); opacity: 0; }
  100% { transform: translateX(0); opacity: 1; }
}

/* Slide in from right */
@keyframes slide-in-right {
  0% { transform: translateX(20px); opacity: 0; }
  100% { transform: translateX(0); opacity: 1; }
}

/* Scale in */
@keyframes scale-in {
  0% { transform: scale(0.95); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* Enhanced focus styles — clear visible indicator for all interactive elements */
.focus-ring {
  outline: none;
}

.focus-ring:focus-visible {
  outline: 2px solid #FF5C00;
  outline-offset: 3px;
  border-radius: 4px;
  box-shadow: 0 0 0 4px rgba(255, 92, 0, 0.15);
}

/* Global focus-visible for all interactive elements */
a:focus-visible,
button:focus-visible,
[role="button"]:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible,
[tabindex]:focus-visible {
  outline: 2px solid #FF5C00;
  outline-offset: 2px;
  border-radius: 4px;
}

/* Remove default browser focus ring, use focus-visible instead */
a:focus:not(:focus-visible),
button:focus:not(:focus-visible),
input:focus:not(:focus-visible),
textarea:focus:not(:focus-visible),
select:focus:not(:focus-visible) {
  outline: none;
}

/* Card hover lift effect — enhanced with deeper shadow */
.card-hover-lift {
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.card-hover-lift:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 92, 0, 0.1);
}
:root.light .card-hover-lift:hover {
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1), 0 0 0 1px rgba(255, 92, 0, 0.15);
}

/* Smooth border color transition */
.border-glow {
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.border-glow:hover {
  border-color: rgba(255, 92, 0, 0.3);
  box-shadow: 0 0 20px rgba(255, 92, 0, 0.1);
}

/* Skeleton loading */
@keyframes skeleton-pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}

.skeleton {
  background: linear-gradient(90deg, #1a1a1a 25%, #252525 50%, #1a1a1a 75%);
  background-size: 200% 100%;
  animation: skeleton-pulse 1.5s ease-in-out infinite;
  border-radius: 8px;
}
:root.light .skeleton {
  background: linear-gradient(90deg, #e5e5e5 25%, #f0f0f0 50%, #e5e5e5 75%);
  background-size: 200% 100%;
}

/* Page transition overlay */
@keyframes page-enter {
  0% { clip-path: inset(0 0 100% 0); }
  100% { clip-path: inset(0 0 0 0); }
}

@keyframes page-exit {
  0% { clip-path: inset(0 0 0 0); }
  100% { clip-path: inset(100% 0 0 0); }
}

/* Stagger children animation helper */
.stagger-children > * {
  opacity: 0;
  animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.stagger-children > *:nth-child(1) { animation-delay: 0ms; }
.stagger-children > *:nth-child(2) { animation-delay: 80ms; }
.stagger-children > *:nth-child(3) { animation-delay: 160ms; }
.stagger-children > *:nth-child(4) { animation-delay: 240ms; }
.stagger-children > *:nth-child(5) { animation-delay: 320ms; }
.stagger-children > *:nth-child(6) { animation-delay: 400ms; }

@keyframes fadeUp {
  0% { opacity: 0; transform: translateY(20px); }
  100% { opacity: 1; transform: translateY(0); }
}

/* Horizontal rule with accent */
.hr-accent {
  border: none;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 92, 0, 0.3), transparent);
}

/* Decorative corner brackets */
.corner-brackets {
  position: relative;
}

.corner-brackets::before,
.corner-brackets::after {
  content: '';
  position: absolute;
  width: 20px;
  height: 20px;
  border-color: rgba(255, 92, 0, 0.3);
  border-style: solid;
}

.corner-brackets::before {
  top: -8px;
  left: -8px;
  border-width: 1px 0 0 1px;
}

.corner-brackets::after {
  bottom: -8px;
  right: -8px;
  border-width: 0 1px 1px 0;
}

/* Smooth number counter */
.tabular-nums {
  font-variant-numeric: tabular-nums;
}

/* ============================================================
   MICRO-INTERACTIONS
   ============================================================ */

/* Card tilt effect — 3D perspective tilt based on mouse position */
.card-tilt {
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  transform-style: preserve-3d;
  perspective: 800px;
}

.card-tilt:hover {
  transform: perspective(800px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg)) scale(1.02);
}

/* Text highlight sweep — light sweep that travels across headings on scroll into view */
.text-sweep {
  background: linear-gradient(
    90deg,
    currentColor 0%,
    currentColor 40%,
    #FF5C00 50%,
    currentColor 60%,
    currentColor 100%
  );
  background-size: 250% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  animation: sweep 1.5s ease-in-out forwards;
}

@keyframes sweep {
  0% { background-position: 100% 0; }
  100% { background-position: 0% 0; }
}

/* Button ripple effect on click */
.btn-ripple {
  position: relative;
  overflow: hidden;
}

.btn-ripple::after {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
  background-image: radial-gradient(circle, rgba(255, 255, 255, 0.15) 10%, transparent 10.01%);
  background-repeat: no-repeat;
  background-position: 50%;
  transform: scale(10, 10);
  opacity: 0;
  transition: transform 0.5s, opacity 1s;
}

.btn-ripple:active::after {
  transform: scale(0, 0);
  opacity: 0.3;
  transition: 0s;
}

/* Link underline animation — animated underline on hover */
.link-underline {
  position: relative;
}

.link-underline::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 0;
  height: 1px;
  background: #FF5C00;
  transition: width 0.3s ease;
}

.link-underline:hover::after {
  width: 100%;
}

/* Counter highlight — gradient text effect with glow for number counters */
.counter-highlight {
  background: linear-gradient(135deg, #FF5C00 0%, #FF8A3D 40%, #FF5C00 60%, #FF7A2E 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: none;
  filter: drop-shadow(0 0 12px rgba(255, 92, 0, 0.35));
}

/* Ripple hover effect for interactive elements */
.ripple-hover {
  position: relative;
  overflow: hidden;
}

.ripple-hover::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at var(--ripple-x, 50%) var(--ripple-y, 50%), rgba(255, 92, 0, 0.15), transparent 60%);
  opacity: 0;
  transition: opacity 0.4s ease;
  pointer-events: none;
  border-radius: inherit;
}

.ripple-hover:hover::after {
  opacity: 1;
}

/* Base button subtle hover feedback — applies to all buttons */
@layer base {
  button,
  [role="button"] {
    position: relative;
  }

  button::after,
  [role="button"]::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at center, rgba(255, 92, 0, 0.06), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  button:hover::after,
  [role="button"]:hover::after {
    opacity: 1;
  }
}

/* ============================================================
   LIGHT MODE — NAVBAR & FOOTER OVERRIDES
   ============================================================ */

/* Navbar light mode */
:root.light .fixed.top-0.bg-\[\#0A0A0A\]\/90,
:root.light header.fixed {
  background: rgba(245, 244, 240, 0.9) !important;
  border-color: rgba(0, 0, 0, 0.08) !important;
  box-shadow: 0 1px 20px rgba(0, 0, 0, 0.06) !important;
}

:root.light .bg-\[\#0A0A0A\]\/98 {
  background: rgba(245, 244, 240, 0.98) !important;
}

/* Navbar logo text in light mode */
:root.light .text-\[\#F5F4F0\] {
  color: #0A0A0A;
}

/* Navbar nav links in light mode */
:root.light .text-\[\#F5F4F0\]\/70 {
  color: rgba(10, 10, 10, 0.6);
}

:root.light .hover\:text-\[\#F5F4F0\]:hover {
  color: #0A0A0A;
}

/* Phone text in light mode */
:root.light .text-\[\#9A9A9A\] {
  color: #6B6B6B;
}

:root.light .hover\:text-\[\#F5F4F0\]:hover {
  color: #0A0A0A;
}

/* Footer light mode */
:root.light footer {
  background: #EBE9E4 !important;
  color: #0A0A0A;
}

:root.light footer .text-\[\#F5F4F0\] {
  color: #0A0A0A;
}

:root.light footer .text-\[\#9A9A9A\],
:root.light footer .text-\[\#6B6B6B\] {
  color: #6B6B6B;
}

:root.light footer .border-white\/\[0\.06\],
:root.light footer .border-white\/\[0\.08\] {
  border-color: rgba(0, 0, 0, 0.08);
}

:root.light footer .bg-white\/\[0\.04\] {
  background: rgba(0, 0, 0, 0.04);
}

:root.light footer .hover\:bg-white\/\[0\.08\]:hover {
  background: rgba(0, 0, 0, 0.06);
}

/* Tooltip in light mode */
:root.light .bg-\[\#1A1A1A\] {
  background: #FFFFFF;
  border-color: rgba(0, 0, 0, 0.08);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
}

:root.light .bg-\[\#1A1A1A\] .text-\[\#F5F4F0\] {
  color: #0A0A0A;
}

:root.light .bg-\[\#1A1A1A\] .text-\[\#9A9A9A\] {
  color: #6B6B6B;
}

/* Accent gradient line in light mode */
:root.light .bg-gradient-to-b.from-\[\#FF5C00\] {
  opacity: 0.7;
}

/* Mobile menu overlay in light mode */
:root.light .bg-black\/60 {
  background: rgba(255, 255, 255, 0.6);
}

/* ThemeToggle button light mode border fix */
:root.light .glass-card {
  border-color: rgba(0, 0, 0, 0.08);
}

/* ─── Glitch Text Effect for 404 ──────────────────────────────── */
.glitch-text {
  background: linear-gradient(135deg, #FF5C00 0%, #FF7A2E 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  position: relative;
}

.glitch-text::before,
.glitch-text::after {
  content: attr(data-text);
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #FF5C00 0%, #FF7A2E 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.glitch-text::before {
  animation: glitch-1 2.5s infinite linear alternate-reverse;
  clip-path: inset(0 0 80% 0);
}

.glitch-text::after {
  animation: glitch-2 3s infinite linear alternate-reverse;
  clip-path: inset(80% 0 0 0);
}

@keyframes glitch-1 {
  0% { transform: translate(0); }
  20% { transform: translate(-3px, 2px); }
  40% { transform: translate(3px, -2px); }
  60% { transform: translate(-2px, 1px); }
  80% { transform: translate(2px, -1px); }
  100% { transform: translate(0); }
}

@keyframes glitch-2 {
  0% { transform: translate(0); }
  20% { transform: translate(2px, -1px); }
  40% { transform: translate(-2px, 1px); }
  60% { transform: translate(3px, 2px); }
  80% { transform: translate(-3px, -2px); }
  100% { transform: translate(0); }
}

/* ============================================================
   SCROLL-TRIGGERED ANIMATION ENHANCEMENTS
   ============================================================ */

/* Parallax text effect — text moves slower than content on scroll */
.parallax-text {
  will-change: transform;
  transition: transform 0.1s linear;
}

/* Staggered list reveals — items appear one by one with 0.05s delay increments */
@keyframes staggerFadeIn {
  0% {
    opacity: 0;
    transform: translateY(16px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.stagger-reveal > * {
  opacity: 0;
  animation: staggerFadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.stagger-reveal > *:nth-child(1) { animation-delay: 0ms; }
.stagger-reveal > *:nth-child(2) { animation-delay: 50ms; }
.stagger-reveal > *:nth-child(3) { animation-delay: 100ms; }
.stagger-reveal > *:nth-child(4) { animation-delay: 150ms; }
.stagger-reveal > *:nth-child(5) { animation-delay: 200ms; }
.stagger-reveal > *:nth-child(6) { animation-delay: 250ms; }
.stagger-reveal > *:nth-child(7) { animation-delay: 300ms; }
.stagger-reveal > *:nth-child(8) { animation-delay: 350ms; }
.stagger-reveal > *:nth-child(9) { animation-delay: 400ms; }
.stagger-reveal > *:nth-child(10) { animation-delay: 450ms; }
.stagger-reveal > *:nth-child(11) { animation-delay: 500ms; }
.stagger-reveal > *:nth-child(12) { animation-delay: 550ms; }

/* Number counter glow — orange glow that fades after count-up completes */
@keyframes counterGlow {
  0% {
    text-shadow: 0 0 20px rgba(255, 92, 0, 0.6), 0 0 40px rgba(255, 92, 0, 0.3);
  }
  70% {
    text-shadow: 0 0 15px rgba(255, 92, 0, 0.4), 0 0 30px rgba(255, 92, 0, 0.15);
  }
  100% {
    text-shadow: none;
  }
}

.counter-glow {
  animation: counterGlow 2.5s ease-out forwards;
}

/* ============================================================
   MICRO-INTERACTION POLISH
   ============================================================ */

/* Magnetic hover effect for cards and buttons — subtly moves element toward cursor */
.magnetic-hover {
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: transform;
}

.magnetic-hover:hover {
  transform: translateY(-4px) scale(1.02);
}

/* Toast notification animation — slide in from right */
@keyframes toast-enter {
  0% {
    transform: translateX(100%);
    opacity: 0;
  }
  100% {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes toast-exit {
  0% {
    transform: translateX(0);
    opacity: 1;
  }
  100% {
    transform: translateX(100%);
    opacity: 0;
  }
}

.toast-enter {
  animation: toast-enter 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.toast-exit {
  animation: toast-exit 0.3s cubic-bezier(0.76, 0, 0.24, 1) forwards;
}

/* Image reveal — clip-path reveal from center outward when scrolling into view */
@keyframes imageRevealCenter {
  0% {
    clip-path: inset(50% 50% 50% 50%);
  }
  100% {
    clip-path: inset(0% 0% 0% 0%);
  }
}

.image-reveal {
  clip-path: inset(50% 50% 50% 50%);
  animation: imageRevealCenter 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* ============================================================
   TYPOGRAPHY POLISH
   ============================================================ */

/* Large headings with accent underline (2px gradient line below) */
.heading-accent {
  position: relative;
  display: inline-block;
}

.heading-accent::after {
  content: '';
  position: absolute;
  bottom: -6px;
  left: 0;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, #FF5C00 0%, #FF7A2E 60%, transparent 100%);
  border-radius: 1px;
}

/* Small monospaced labels with accent color, uppercase tracking */
.mono-label {
  font-family: var(--font-jetbrains-mono), monospace;
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: #FF5C00;
}

/* Larger body text with improved line-height and letter-spacing */
.body-large {
  font-family: var(--font-dm-sans), system-ui, sans-serif;
  font-size: 1.25rem;
  line-height: 1.75;
  letter-spacing: 0.01em;
  color: #9A9A9A;
}

:root.light .body-large {
  color: #4A4A4A;
}

/* ─── Additional Utility Classes ─── */

/* Gradient text animation */
.text-gradient-animate {
  background: linear-gradient(90deg, #FF5C00, #FF7A2E, #FF5C00);
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: text-gradient-shift 3s ease infinite;
}

@keyframes text-gradient-shift {
  0% { background-position: 0% center; }
  50% { background-position: 100% center; }
  100% { background-position: 0% center; }
}

/* Hover expand effect for cards */
.hover-expand {
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}
.hover-expand:hover {
  transform: scale(1.02);
  box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}

/* Accent border bottom animation */
.border-bottom-animate {
  position: relative;
}
.border-bottom-animate::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 0;
  height: 2px;
  background: linear-gradient(90deg, #FF5C00, #FF7A2E);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  transform: translateX(-50%);
}
.border-bottom-animate:hover::after {
  width: 100%;
}

/* Subtle hover lift for interactive elements */
.hover-lift {
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
.hover-lift:hover {
  transform: translateY(-2px);
}

/* Pulse glow for active/online indicators */
.pulse-glow {
  animation: pulse-glow 2s ease-in-out infinite;
}
@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 5px rgba(255, 92, 0, 0.2); }
  50% { box-shadow: 0 0 20px rgba(255, 92, 0, 0.4), 0 0 40px rgba(255, 92, 0, 0.1); }
}

/* Smooth image reveal — left-to-right wipe */
.image-reveal-wipe {
  clip-path: inset(0 100% 0 0);
  animation: image-reveal-wipe 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
@keyframes image-reveal-wipe {
  to { clip-path: inset(0 0 0 0); }
}

/* Scroll snap for horizontal carousels */
.scroll-snap-x {
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
}
.scroll-snap-x > * {
  scroll-snap-align: start;
}

/* Custom scrollbar for dark theme */
.scrollbar-dark {
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,0.1) transparent;
}
.scrollbar-dark::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
.scrollbar-dark::-webkit-scrollbar-track {
  background: transparent;
}
.scrollbar-dark::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,0.1);
  border-radius: 3px;
}
.scrollbar-dark::-webkit-scrollbar-thumb:hover {
  background: rgba(255,255,255,0.2);
}

/* Focus visible ring for keyboard navigation */
.focus-ring-visible:focus-visible {
  outline: 2px solid #FF5C00;
  outline-offset: 2px;
}

/* Text balance for headings */
.text-balance {
  text-wrap: balance;
}

/* Subtle text reveal animation */
@keyframes text-reveal {
  from {
    clip-path: inset(0 100% 0 0);
  }
  to {
    clip-path: inset(0 0 0 0);
  }
}

.text-reveal {
  animation: text-reveal 0.8s ease-out forwards;
}

/* Gradient border animation */
@keyframes border-spin {
  to {
    --border-angle: 360deg;
  }
}

.animated-border {
  position: relative;
  border: 1px solid transparent;
  background-clip: padding-box;
}

.animated-border::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  background: conic-gradient(from var(--border-angle, 0deg), transparent 60%, #FF5C00 80%, transparent 100%);
  z-index: -1;
  animation: border-spin 4s linear infinite;
}

/* Smooth number counter */
@keyframes count-up {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.count-up {
  animation: count-up 0.6s ease-out forwards;
}

/* Focus ring animation */
@keyframes focus-ring-pulse {
  0%, 100% { box-shadow: 0 0 0 2px rgba(255, 92, 0, 0.3); }
  50% { box-shadow: 0 0 0 4px rgba(255, 92, 0, 0.15); }
}

.focus-ring-pulse:focus-visible {
  animation: focus-ring-pulse 2s ease-in-out infinite;
}

/* Smooth image zoom on hover */
.img-zoom {
  overflow: hidden;
}

.img-zoom img,
.img-zoom > * {
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.img-zoom:hover img,
.img-zoom:hover > * {
  transform: scale(1.05);
}

/* Noise texture background variant */
.noise-texture-v2 {
  position: relative;
}
.noise-texture-v2::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 1;
}

/* Page transition CSS animations (replaces Framer Motion for sticky compatibility) */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}
